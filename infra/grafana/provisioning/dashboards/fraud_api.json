          "noValue": "No observations",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fraud_score_bucket{job=\"api\"}[$__range]))) >= 0",
          "legendFormat": "p50 score",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Estimated quantile of model probabilities for successful API predictions in the selected range. Histogram bucket width is 0.1; estimates are approximate and do not measure model accuracy."
    },
