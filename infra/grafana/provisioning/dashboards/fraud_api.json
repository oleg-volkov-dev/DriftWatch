{
  "uid": "driftwatch-fraud-api",
  "title": "DriftWatch \u2014 API & Drift",
  "tags": [
    "driftwatch"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 18,
      "type": "stat",
      "title": "API scrape health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up{job=\"api\"})",
          "legendFormat": "API scrape health",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Prometheus scrape reachability at the selected end time. Does not imply a model is loaded."
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Model loaded",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No model",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(api_model_loaded{job=\"api\"} and on (job, instance) (up{job=\"api\"} == 1))",
          "legendFormat": "Model loaded",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Whether a model is loaded on reachable API instances. This is readiness, not a guarantee of prediction quality."
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Pushgateway scrape health",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up{job=\"pushgateway\"})",
          "legendFormat": "Pushgateway scrape health",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Prometheus reachability of the batch metrics gateway. Does not mean a monitoring job has run."
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Monitoring result age",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "noValue": "No monitoring result"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(push_time_seconds{job=\"driftwatch_monitoring\"} > 0)",
          "legendFormat": "Monitoring result age",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Elapsed time since the last successful monitoring metrics push, relative to the selected end time. Results persist until another push or gateway restart. No freshness SLA is configured."
    },
    {
      "id": 22,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Online panels** measure calls to `/predict`; generating data, training, and running demos do **not** create API prediction traffic. Send predictions from the app to populate them. Counts and score stats use the selected time range; graphs use an adaptive rolling window. **Offline drift panels** retain the latest published batch at the selected end time. Check its age. Model flags are predictions, not confirmed fraud; drift severity does not measure model accuracy."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Prediction attempts (selected range)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "noValue": "No samples"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(api_requests_total{job=\"api\"}[$__range]))",
          "legendFormat": "Attempts",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Selected time range. Prometheus estimates counter increases between scrapes and accounts for resets; counts may be fractional and cannot recover requests before the first scrape. Counts validated /predict calls, including model-unavailable and inference errors; excludes HTTP 422 validation failures and other endpoints."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prediction errors (selected range)",
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "No samples"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(api_errors_total{job=\"api\"}[$__range]))",
          "legendFormat": "Errors",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Selected time range. Prometheus estimates counter increases between scrapes and accounts for resets; counts may be fractional and cannot recover requests before the first scrape. Model-unavailable (503) and inference failures (500). Excludes validation failures (422), reloads, and other endpoints."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prediction error fraction (selected range)",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "noValue": "No observations"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(api_errors_total{job=\"api\"}[$__range])) / (sum(increase(api_requests_total{job=\"api\"}[$__range])) > 0)",
          "legendFormat": "Error fraction",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Counts validated /predict calls, including model-unavailable and inference errors; excludes HTTP 422 validation failures and other endpoints. Empty when no attempts occurred. Colors are illustrative demo thresholds (5% / 20%), not an SLO."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mean model execution time (selected range)",
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No observations"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(api_request_latency_seconds_sum{job=\"api\"}[$__range])) / (sum(increase(api_request_latency_seconds_count{job=\"api\"}[$__range])) > 0)",
          "legendFormat": "Mean duration",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Time inside the prediction handler for feature preparation, inference, and response construction, including inference exceptions. Excludes validation, model-unavailable responses, queuing, and network time. Empty without timed attempts."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prediction attempts and errors / second",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "No samples"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(api_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "Attempts / s",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(api_errors_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "Errors / s",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "description": "Counts validated /predict calls, including model-unavailable and inference errors; excludes HTTP 422 validation failures and other endpoints. Rolling window adapts to graph resolution and scrape interval."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model execution time \u2014 estimated percentiles",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "noValue": "No observations"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(api_request_latency_seconds_bucket{job=\"api\"}[$__rate_interval]))) >= 0",
          "legendFormat": "p50",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_latency_seconds_bucket{job=\"api\"}[$__rate_interval]))) >= 0",
          "legendFormat": "p95",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_latency_seconds_bucket{job=\"api\"}[$__rate_interval]))) >= 0",
          "legendFormat": "p99",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "description": "Bucket-based estimates over an adaptive rolling window; aggregated across API instances. Same timing scope as mean model execution time. Gaps mean no timed attempts."
    },
    {
      "id": 7,
      "type": "row",
      "title": "Online model predictions \u2014 not confirmed fraud",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Flagged prediction fraction (selected range)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No observations",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fraud_predictions_total{job=\"api\",result=\"fraud\"}[$__range])) / (sum(increase(fraud_predictions_total{job=\"api\"}[$__range])) > 0)",
          "legendFormat": "Flagged fraction",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Share of successful API predictions with score >= 0.5 in the selected range. This is not the true fraud rate, precision, recall, or batch fraud prevalence. Empty without successful predictions."
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Predicted score p50 (selected range)",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
